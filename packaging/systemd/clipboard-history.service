[Unit]
Description=Universal Linux Clipboard History Daemon
Documentation=https://github.com/example/clipboard-history
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clipboard-history-daemon
Restart=on-failure
RestartSec=3s
Environment=RUST_LOG=info
Slice=session.slice

# Security Sandboxing for User Service
ProtectSystem=strict
ReadWritePaths=%h/.local/share/clipboard-history %h/.config/clipboard-history %t
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
